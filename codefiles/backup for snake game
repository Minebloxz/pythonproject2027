# -*- coding: utf-8 -*-
"""
Spyder Editor

This is a temporary script file.
"""

import random
import time

# Dictionary mappings for Snakes and Ladders
# format -> {start_position: end_position}
SNAKES = {
    16: 6, 
    47: 26, 
    49: 11, 
    56: 53, 
    62: 19, 
    64: 60, 
    87: 24, 
    93: 73, 
    95: 75, 
    98: 78
}

LADDERS = {
    1: 38, 
    4: 14, 
    9: 31, 
    21: 42, 
    28: 84, 
    36: 44, 
    51: 67, 
    71: 91, 
    80: 100
}

def roll_dice():
    """Simulates rolling a 6-sided dice."""
    return random.randint(1, 6)

def check_square(player_name, current_position):
    """Checks if the player landed on a snake or a ladder."""
    if current_position in SNAKES:
        print(f"🐍 Oh no! {player_name} got bit by a snake! Sliding down from {current_position} to {SNAKES[current_position]}.")
        return SNAKES[current_position]
    
    if current_position in LADDERS:
        print(f"🪜 Woohoo! {player_name} found a ladder! Climbing up from {current_position} to {LADDERS[current_position]}.")
        return LADDERS[current_position]
        
    return current_position

def play_game():
    print("=" * 40)
    print("Welcome to the Snake & Ladder Game!")
    print("=" * 40)
    
    player1 = input("Enter Player 1 Name: ").strip() or "Player 1"
    player2 = input("Enter Player 2 Name: ").strip() or "Player 2"
    
    # Track positions (Start at position 0)
    positions = {player1: 0, player2: 0}
    players = [player1, player2]
    
    turn = 0
    game_over = False

    while not game_over:
        current_player = players[turn]
        print(f"\n--- {current_player}'s Turn (Current Position: {positions[current_player]}) ---")
        input(f"Press Enter to roll the dice...")
        
        dice_value = roll_dice()
        print(f"🎲 {current_player} rolled a {dice_value}!")
        
        # Calculate tentative new position
        new_position = positions[current_player] + dice_value
        
        if new_position > 100:
            print(f"⚠️ Roll exceeds 100! {current_player} stays at {positions[current_player]}. Need exactly {100 - positions[current_player]} to win.")
        else:
            # Update position and check for snakes/ladders
            positions[current_player] = new_position
            positions[current_player] = check_square(current_player, positions[current_player])
            print(f"📌 {current_player} is now on square {positions[current_player]}")
        
        # Check win condition
        if positions[current_player] == 100:
            print("\n" + "🎉" * 15)
            print(f"🏆 CONGRATULATIONS! {current_player} WINS THE GAME! 🏆")
            print("🎉" * 15)
            game_over = True
            break
            
        # Switch turns
        turn = 1 - turn
        time.sleep(0.5)

if __name__ == "__main__":
    play_game()
